# Local on the DB host: unix socket, no password needed
SKRY_DB_URL=postgresql:///knowledge
# From another machine on the tailnet (after running scripts/setup-tailnet-db.sh on the host):
# SKRY_DB_URL=postgresql://USER:PASSWORD@HOST/knowledge
SKRY_OLLAMA_URL=http://localhost:11434
SKRY_EMBED_MODEL=nomic-embed-text

# Default knobs
SKRY_TOP_CHUNKS=60
SKRY_TOP_ENTITIES=20
SKRY_MIN_NAME_LEN=3
